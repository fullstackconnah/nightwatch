# Placeholders only. The real values live in the stack's own .env on the server.
# At least 32 characters; the same value goes into nightwatch Settings.
MEDIA_WORKER_TOKEN=
# The server's LAN address to publish port 8091 on.
MEDIA_WORKER_BIND=
# Owner of the media folders (stat -c %u:%g on the movies folder).
PUID=
PGID=
TZ=Australia/Sydney
# Optional Jellyfin refresh after a swap or Undo; leave empty to skip it. The key is read from here only.
JELLYFIN_URL=
JELLYFIN_API_KEY=
# Where Jellyfin sees the same folders.
JELLYFIN_ROOTS=movies=/media/movies,tv=/media/tv
# Compress is off until calibration is done. To turn it on, add MEDIA_COMPRESS_ENABLED=1 to the server's own .env.
