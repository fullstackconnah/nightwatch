# --- Docker Engine access ---------------------------------------------------
# Production (compose): the socket proxy on the internal network.
DOCKER_HOST=tcp://socket-proxy:2375
# Local dev against the homelab over an SSH tunnel:
#   ssh -N -L 127.0.0.1:12375:/var/run/docker.sock homelab@homelab.local
# DOCKER_HOST=tcp://127.0.0.1:12375

# --- Auth -------------------------------------------------------------------
# Generate with: npm run hash-password -- 'your-password'
ADMIN_PASSWORD_HASH=
# REQUIRED. Any long random string; sessions are invalidated when it changes. Without it production login answers 503.
SESSION_SECRET=

# --- Dashboard --------------------------------------------------------------
# The server .env sets the real LAN address. Used to build "open app" URLs for containers with published ports.
PUBLIC_HOST=homelab.local
# Where user config (widgets, groups, icons) is persisted.
DATA_DIR=./data
# Link target for the "Stacks (Dockge)" nav item.
DOCKGE_URL=http://homelab.local:5001
# Host paths the create-container form may bind-mount (comma-separated, absolute).
# Anything else is refused; named Docker volumes are always allowed. Default shown.
# Paths are checked for symlinks under HOST_ROOTFS; if it is unreadable all binds are refused.
# Default is /mnt/media only. Listing /mnt/docker/stacks grants write access to every
# stack's compose file and .env.
# CREATE_BIND_ROOTS=/mnt/media
# Networks the create-container form may join (comma-separated); blank means bridge. Default shown.
# CREATE_NETWORKS=bridge

# --- Optional integrations (all can also be set in Settings; Settings wins over these) ---
# Placeholder values only. Leave a block commented out to keep that feature "not connected".
# Orchestra control service (PC side).
# ORCHESTRA_URL=http://orchestra.example:8787
# ORCHESTRA_TOKEN=
# Hermes control API.
# HERMES_API_URL=http://hermes.example:8642
# HERMES_API_TOKEN=
# Ollama, for the local-models list.
# OLLAMA_URL=http://ollama.example:11434
# Kiosk "Admin" tap PIN. Unset = the kiosk cannot elevate.
# KIOSK_PIN=
# Bearer token for the /api/mcp endpoint. Unset = MCP answers 503.
# MCP_TOKEN=
# ODIP backup status file. The default is the host-rootfs mount (HOST_ROOTFS) plus
# /mnt/docker/backups/status/odip-backup.json. An override must be a path inside the container.
# ODIP_BACKUP_STATUS_PATH=/path/inside/container/odip-backup.json
# Name shown for this host in metrics. Set in docker-compose.yml's environment: block, not here
# (that block wins over this file).
# HOST_NAME=homelab
